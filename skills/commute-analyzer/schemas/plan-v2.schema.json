{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Command1264/agent-skills/skills/commute-analyzer/schemas/plan-v2.schema.json",
  "title": "Commute Analyzer immutable plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_contract_version", "created_at", "input_compatibility", "dependency", "schedule", "preview", "samples", "plan_id"],
  "properties": {
    "schema_version": {"const": "2"},
    "plan_contract_version": {"const": "2.0.0"},
    "created_at": {"type": "string", "format": "date-time"},
    "input_compatibility": {"$ref": "#/$defs/inputCompatibility"},
    "dependency": {"$ref": "#/$defs/dependency"},
    "schedule": {"$ref": "#/$defs/schedule"},
    "preview": {"$ref": "#/$defs/preview"},
    "samples": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sample"}},
    "plan_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "inputCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config_schema_version", "plan_request_schema_version", "adapter"],
      "properties": {
        "config_schema_version": {"enum": ["1", "2"]},
        "plan_request_schema_version": {"enum": ["1", "2"]},
        "adapter": {"enum": ["v1_to_v2", null]}
      }
    },
    "itineraryLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_points", "maximum_points", "maximum_intermediate_waypoints", "waypoint_order"],
      "properties": {
        "minimum_points": {"const": 2},
        "maximum_points": {"const": 12},
        "maximum_intermediate_waypoints": {"const": 10},
        "waypoint_order": {"const": "fixed"}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "skill_version", "cli_contract_version", "schema_version", "travel_modes", "output_profile", "itinerary_limits"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "skill_version": {"type": "string", "pattern": "^2\\."},
        "cli_contract_version": {"const": "2.0.0"},
        "schema_version": {"const": "2"},
        "travel_modes": {"type": "array", "const": ["DRIVE", "TWO_WHEELER"]},
        "output_profile": {"const": "itinerary_summary"},
        "itinerary_limits": {"$ref": "#/$defs/itineraryLimits"}
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_date", "end_date", "weeks", "weekdays", "dates", "utc_offset", "outbound_departure_time", "return_departure_time", "travel_modes"],
      "properties": {
        "start_date": {"type": "string", "format": "date"},
        "end_date": {"type": "string", "format": "date"},
        "weeks": {"type": "integer", "minimum": 1, "maximum": 4},
        "weekdays": {"type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 7}},
        "dates": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "date"}},
        "utc_offset": {"type": "string", "pattern": "^(?:[+-](?:0[0-9]|1[0-3]):[0-5][0-9]|[+-]14:00)$"},
        "outbound_departure_time": {"$ref": "config-v2.schema.json#/$defs/localTime"},
        "return_departure_time": {"$ref": "config-v2.schema.json#/$defs/localTime"},
        "travel_modes": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["DRIVE", "TWO_WHEELER"]}}
      }
    },
    "directionPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "point_labels", "point_count", "intermediate_count", "leg_count"],
      "properties": {
        "direction": {"enum": ["outbound", "return"]},
        "point_labels": {"type": "array", "minItems": 2, "maxItems": 12, "items": {"$ref": "config-v2.schema.json#/$defs/label"}},
        "point_count": {"type": "integer", "minimum": 2, "maximum": 12},
        "intermediate_count": {"type": "integer", "minimum": 0, "maximum": 10},
        "leg_count": {"type": "integer", "minimum": 1, "maximum": 11}
      }
    },
    "journeyPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journey_id", "journey_label", "directions"],
      "properties": {
        "journey_id": {"$ref": "config-v2.schema.json#/$defs/id"},
        "journey_label": {"$ref": "config-v2.schema.json#/$defs/label"},
        "directions": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/directionPreview"}}
      }
    },
    "skuCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routes_compute_pro", "routes_compute_enterprise"],
      "properties": {
        "routes_compute_pro": {"type": "integer", "minimum": 0},
        "routes_compute_enterprise": {"type": "integer", "minimum": 0}
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journey_count", "request_count", "planned_leg_count", "retry_limit", "maximum_http_requests", "rate_limit_qpm", "local_rate_limit_only", "confirmation_threshold", "confirmation_required", "estimated_sku_requests", "journeys"],
      "properties": {
        "journey_count": {"type": "integer", "minimum": 1},
        "request_count": {"type": "integer", "minimum": 1},
        "planned_leg_count": {"type": "integer", "minimum": 1},
        "retry_limit": {"const": 2},
        "maximum_http_requests": {"type": "integer", "minimum": 3},
        "rate_limit_qpm": {"type": "integer", "minimum": 1, "maximum": 3000},
        "local_rate_limit_only": {"const": true},
        "confirmation_threshold": {"type": "integer", "minimum": 1, "maximum": 1000},
        "confirmation_required": {"type": "boolean"},
        "estimated_sku_requests": {"$ref": "#/$defs/skuCounts"},
        "journeys": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/journeyPreview"}}
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "journey_id", "journey_label", "date", "direction", "points", "travel_mode", "departure_time", "expected_leg_count"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "journey_id": {"$ref": "config-v2.schema.json#/$defs/id"},
        "journey_label": {"$ref": "config-v2.schema.json#/$defs/label"},
        "date": {"type": "string", "format": "date"},
        "direction": {"enum": ["outbound", "return"]},
        "points": {"type": "array", "minItems": 2, "maxItems": 12, "items": {"$ref": "config-v2.schema.json#/$defs/resolvedPoint"}},
        "travel_mode": {"enum": ["DRIVE", "TWO_WHEELER"]},
        "departure_time": {"type": "string", "format": "date-time"},
        "expected_leg_count": {"type": "integer", "minimum": 1, "maximum": 11}
      }
    }
  }
}
