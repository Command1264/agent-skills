{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Command1264/agent-skills/skills/commute-analyzer/schemas/plan-request-v1.schema.json",
  "title": "Commute Analyzer plan request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": {"const": "1"},
    "start_date": {"type": "string", "format": "date"},
    "weeks": {"type": "integer", "minimum": 1, "maximum": 4},
    "weekdays": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 7}
    },
    "morning_departure_time": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
    "evening_departure_time": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
    "travel_modes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["DRIVE", "TWO_WHEELER"]}
    },
    "rate_limit_qpm": {"type": "integer", "minimum": 1, "maximum": 3000},
    "confirmation_threshold": {"type": "integer", "minimum": 1, "maximum": 1000},
    "schedule_mode": {"const": "fixed_departure"},
    "additional_companies": {
      "type": "array",
      "items": {"$ref": "config-v1.schema.json#/$defs/company"}
    }
  }
}
