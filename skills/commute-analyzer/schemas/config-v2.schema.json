{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Command1264/agent-skills/skills/commute-analyzer/schemas/config-v2.schema.json",
  "title": "Commute Analyzer private config v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "locations", "utc_offset", "outbound_departure_time", "return_departure_time"],
  "properties": {
    "schema_version": {"const": "2"},
    "locations": {
      "type": "array",
      "items": {"$ref": "#/$defs/namedLocation"}
    },
    "utc_offset": {"type": "string", "pattern": "^(?:[+-](?:0[0-9]|1[0-3]):[0-5][0-9]|[+-]14:00)$"},
    "outbound_departure_time": {"$ref": "#/$defs/localTime"},
    "return_departure_time": {"$ref": "#/$defs/localTime"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "label": {"type": "string", "minLength": 1, "maxLength": 80},
    "localTime": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": {"type": "string", "minLength": 1},
        "place_id": {"type": "string", "minLength": 1}
      },
      "oneOf": [
        {"required": ["address"]},
        {"required": ["place_id"]}
      ]
    },
    "namedLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "location"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"$ref": "#/$defs/label"},
        "location": {"$ref": "#/$defs/location"}
      }
    },
    "resolvedPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "location"],
      "properties": {
        "label": {"$ref": "#/$defs/label"},
        "location": {"$ref": "#/$defs/location"}
      }
    }
  }
}
