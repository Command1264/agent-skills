{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Command1264/agent-skills/skills/commute-analyzer/schemas/config-v1.schema.json",
  "title": "Commute Analyzer private config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "home", "companies", "utc_offset", "morning_departure_time", "evening_departure_time"],
  "properties": {
    "schema_version": {"const": "1"},
    "home": {"$ref": "#/$defs/endpoint"},
    "companies": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/company"}
    },
    "utc_offset": {"type": "string", "pattern": "^(?:[+-](?:0[0-9]|1[0-3]):[0-5][0-9]|[+-]14:00)$"},
    "morning_departure_time": {"$ref": "#/$defs/localTime"},
    "evening_departure_time": {"$ref": "#/$defs/localTime"}
  },
  "$defs": {
    "localTime": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": {"type": "string", "minLength": 1},
        "place_id": {"type": "string", "minLength": 1}
      },
      "oneOf": [
        {"required": ["address"]},
        {"required": ["place_id"]}
      ]
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "location"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "location": {"$ref": "#/$defs/location"}
      }
    },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "location"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "name": {"type": "string", "minLength": 1},
        "location": {"$ref": "#/$defs/location"}
      }
    }
  }
}
