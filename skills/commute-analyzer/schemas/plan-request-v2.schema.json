{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Command1264/agent-skills/skills/commute-analyzer/schemas/plan-request-v2.schema.json",
  "title": "Commute Analyzer plan request v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "journeys"],
  "properties": {
    "schema_version": {"const": "2"},
    "start_date": {"type": "string", "format": "date"},
    "weeks": {"type": "integer", "minimum": 1, "maximum": 4},
    "weekdays": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 7}
    },
    "outbound_departure_time": {"$ref": "config-v2.schema.json#/$defs/localTime"},
    "return_departure_time": {"$ref": "config-v2.schema.json#/$defs/localTime"},
    "travel_modes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["DRIVE", "TWO_WHEELER"]}
    },
    "rate_limit_qpm": {"type": "integer", "minimum": 1, "maximum": 3000},
    "confirmation_threshold": {"type": "integer", "minimum": 1, "maximum": 1000},
    "schedule_mode": {"const": "fixed_departure"},
    "journeys": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/journey"}
    }
  },
  "$defs": {
    "savedPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location_id"],
      "properties": {
        "location_id": {"$ref": "config-v2.schema.json#/$defs/id"}
      }
    },
    "inlinePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "location"],
      "properties": {
        "label": {"$ref": "config-v2.schema.json#/$defs/label"},
        "location": {"$ref": "config-v2.schema.json#/$defs/location"}
      }
    },
    "point": {
      "oneOf": [
        {"$ref": "#/$defs/savedPoint"},
        {"$ref": "#/$defs/inlinePoint"}
      ]
    },
    "points": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/point"}
    },
    "outbound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points"],
      "properties": {"points": {"$ref": "#/$defs/points"}}
    },
    "explicitReturn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points"],
      "properties": {"points": {"$ref": "#/$defs/points"}}
    },
    "reversedReturn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reverse_outbound"],
      "properties": {"reverse_outbound": {"const": true}}
    },
    "return": {
      "oneOf": [
        {"$ref": "#/$defs/explicitReturn"},
        {"$ref": "#/$defs/reversedReturn"}
      ]
    },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "outbound", "return"],
      "properties": {
        "id": {"$ref": "config-v2.schema.json#/$defs/id"},
        "label": {"$ref": "config-v2.schema.json#/$defs/label"},
        "outbound": {"$ref": "#/$defs/outbound"},
        "return": {"$ref": "#/$defs/return"}
      }
    }
  }
}
