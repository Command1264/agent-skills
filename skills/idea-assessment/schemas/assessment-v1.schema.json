{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Command1264/agent-skills/skills/idea-assessment/schemas/assessment-v1.schema.json",
  "title": "idea-assessment assessment v1",
  "description": "文字欄位可用 [n] 引用 sources 的 id；render 會另外檢查引用存在、日期有效與 id 不重複。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "idea",
    "date",
    "verdict",
    "verdict_reason",
    "scale_max",
    "dimensions",
    "context",
    "competitors",
    "demand",
    "trends",
    "ai_risk",
    "considerations",
    "experiment",
    "kill_criteria",
    "research_gaps",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "idea": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "verdict": {
      "enum": [
        "pursue",
        "validate-first",
        "pass"
      ]
    },
    "verdict_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "scale_max": {
      "const": 5
    },
    "axis_low_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "axis_high_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "score",
          "confidence",
          "summary"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "context": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "value",
          "assumed"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "assumed": {
            "type": "boolean"
          }
        }
      }
    },
    "competitors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "status",
          "price",
          "difference",
          "complaints"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "url": {
            "type": "string",
            "pattern": "^https?://[^\\s\"'<>]+$"
          },
          "kind": {
            "enum": [
              "open",
              "closed",
              "platform",
              "workaround"
            ]
          },
          "status": {
            "enum": [
              "active",
              "stale",
              "shut-down",
              "unknown"
            ]
          },
          "price": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "difference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "complaints": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "demand": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "trends": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "ai_risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "general_agent",
        "platform",
        "value"
      ],
      "properties": {
        "general_agent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        }
      }
    },
    "considerations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "note"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis",
        "method",
        "duration",
        "cost",
        "success",
        "failure"
      ],
      "properties": {
        "hypothesis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "method": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "duration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "cost": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "success": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "failure": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    },
    "kill_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "research_gaps": {
      "type": "array",
      "minItems": 0,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "reason"
        ],
        "properties": {
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "url",
          "accessed"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "url": {
            "type": "string",
            "pattern": "^https?://[^\\s\"'<>]+$"
          },
          "accessed": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    }
  }
}
