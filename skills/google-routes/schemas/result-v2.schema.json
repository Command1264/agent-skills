{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Command1264/agent-skills/google-routes/result-v2.schema.json",
  "title": "google-routes itinerary result envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cli_contract_version", "profile", "status", "results"],
  "properties": {
    "schema_version": {"const": "2"},
    "cli_contract_version": {"const": "2.0.0"},
    "profile": {"const": "itinerary_summary"},
    "status": {"enum": ["success", "degraded", "partial_success", "failure"]},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/route_result"},
          {"$ref": "#/$defs/error_result"}
        ]
      }
    }
  },
  "$defs": {
    "fallback": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["routing_mode", "reason"],
      "properties": {
        "routing_mode": {"type": "string"},
        "reason": {"type": "string"}
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "place_id"],
      "properties": {
        "label": {"type": "string"},
        "place_id": {"type": ["string", "null"]}
      }
    },
    "leg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_label", "to_label", "distance_meters", "duration_seconds", "static_duration_seconds"],
      "properties": {
        "from_label": {"type": "string"},
        "to_label": {"type": "string"},
        "distance_meters": {"type": "integer", "minimum": 0},
        "duration_seconds": {"type": "number", "minimum": 0},
        "static_duration_seconds": {"type": "number", "minimum": 0}
      }
    },
    "route_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "status", "travel_mode", "distance_meters", "duration_seconds", "static_duration_seconds", "warnings", "fallback", "points", "legs", "attempts"],
      "properties": {
        "request_id": {"type": "string"},
        "status": {"enum": ["success", "degraded"]},
        "travel_mode": {"enum": ["DRIVE", "TWO_WHEELER"]},
        "distance_meters": {"type": "integer", "minimum": 0},
        "duration_seconds": {"type": "number", "minimum": 0},
        "static_duration_seconds": {"type": "number", "minimum": 0},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "fallback": {"$ref": "#/$defs/fallback"},
        "points": {"type": "array", "minItems": 2, "maxItems": 12, "items": {"$ref": "#/$defs/point"}},
        "legs": {"type": "array", "minItems": 1, "maxItems": 11, "items": {"$ref": "#/$defs/leg"}},
        "attempts": {"type": "integer", "minimum": 1, "maximum": 3}
      }
    },
    "error_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "status", "travel_mode", "error", "attempts"],
      "properties": {
        "request_id": {"type": "string"},
        "status": {"const": "error"},
        "travel_mode": {"enum": ["DRIVE", "TWO_WHEELER"]},
        "attempts": {"type": "integer", "minimum": 1, "maximum": 3},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": {"type": "string"},
            "message": {"type": "string"},
            "retryable": {"type": "boolean"},
            "http_status": {"type": "integer", "minimum": 300, "maximum": 599}
          }
        }
      }
    }
  }
}
